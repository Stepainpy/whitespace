S S S/TTSTTSTT/L ; push +219
S S T/TTSTTSTT/L ; push -219

S LS ; dup
S LT ; swap
S LL ; drop

S TS S/TST/L ; copy 5
S TL S/TST/L ; slide 5

------------------------------

TS SS ; add
TS ST ; sub
TS SL ; mul
TS TS ; div
TS TT ; mod

------------------------------

TT S ; store
TT T ; retrieve/load

------------------------------

TL SS ; out-char
TL ST ; out-int

TL TS ; in-char
TL TT ; in-int

------------------------------

L SS STS/L ; mark STS
L ST STS/L ; call STS
L SL STS/L ; goto STS
L TS STS/L ; if-zero STS
L TT STS/L ; if-neg STS

L TL ; ret
L LL ; exit
